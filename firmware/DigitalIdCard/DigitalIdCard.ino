/*
  Digital ID Card - ESP32-C3 SuperMini

  Main display : 1.69" ST7789 TFT (240x280, SPI)
                 plays a JPEG-frame animation and shows still images
  Side display : 0.96" SSD1306 OLED (128x64, I2C)
                 scrolling text + a large caption for each screen
  Buttons      : NEXT / PREVIOUS cycle through the screens

  Screens: 0 = animation, 1..N = still images (see `images` below).
  Replace animation.h / image_*.h with your own using the scripts in /tools.
*/

#include <SPI.h>
#include <Wire.h>
#include <pgmspace.h>
#include <string.h>

#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <Adafruit_SSD1306.h>
#include <JPEGDEC.h>

#include "animation.h"   // generated by tools/gif_to_header.py
#include "image_one.h"   // generated by tools/image_to_header.py
#include "image_two.h"

// ======================================================================
//  USER SETTINGS - edit these to personalise your card
// ======================================================================

// One entry per screen: [0] = animation, [1] = image one, [2] = image two.
// "\x07" prints a bullet in the OLED font (a typed bullet shows as garbage).

// Text that scrolls along the top of the OLED
const char *const scrollingTexts[] = {
  "@your.handle \x07 Your Role \x07 Maker",
  "@your.handle \x07 Your Name \x07 Maker",
  "@your.handle \x07 Your Role \x07 Your Name"
};

// Large caption under the scroller (keep it short: about 7 characters fit)
const char *const mainTexts[] = {
  "Name",
  "Role",
  "Maker"
};

// Still images shown after the animation. To add one, include its header
// above and append its array here (the text arrays above need an entry too).
const uint16_t *const images[] = { imageOneData, imageTwoData };

// OLED scroll speed in ms per pixel. LOWER = FASTER.
#define SCROLL_INTERVAL 25

// ======================================================================
//  PIN CONFIGURATION (see README for wiring)
// ======================================================================

// TFT (SPI)
#define TFT_MOSI 5   // display pin SDA
#define TFT_SCLK 6   // display pin SCL
#define TFT_CS   7
#define TFT_DC   10
#define TFT_RST  4

// OLED (I2C)
#define OLED_SDA 0
#define OLED_SCL 1
#define OLED_WIDTH   128
#define OLED_HEIGHT  64
#define OLED_ADDRESS 0x3C

// Buttons (wired between the GPIO and GND, internal pull-up is used)
#define BUTTON_NEXT 3
#define BUTTON_PREV 20
#define DEBOUNCE_MS 40

// ======================================================================
//  GLOBALS
// ======================================================================

Adafruit_ST7789 tft(&SPI, TFT_CS, TFT_DC, TFT_RST);
Adafruit_SSD1306 oled(OLED_WIDTH, OLED_HEIGHT, &Wire, -1);
JPEGDEC jpeg;

const int IMAGE_COUNT  = sizeof(images) / sizeof(images[0]);
const int SCREEN_COUNT = IMAGE_COUNT + 1;  // +1 for the animation

// Set by loop(), read by oledTask
volatile int currentScreen = 0;

// The screen whose text the OLED is currently scrolling
int oledScreen = 0;
int textX = OLED_WIDTH;

// 11x11 star drawn next to the caption
#define STAR_W 11
#define STAR_H 11
const unsigned char starBitmap[] PROGMEM = {
  0x04, 0x00,
  0x04, 0x00,
  0x0E, 0x00,
  0x0E, 0x00,
  0x7F, 0xC0,
  0xFF, 0xE0,
  0x7F, 0xC0,
  0x0E, 0x00,
  0x0E, 0x00,
  0x04, 0x00,
  0x04, 0x00
};

// ======================================================================
//  BUTTONS
// ======================================================================

struct Button {
  uint8_t pin;
  bool lastReading;
  bool stableState;
  unsigned long lastChange;
  bool pressed;

  // Debounces the pin and sets `pressed` once per press
  void update() {
    bool reading = digitalRead(pin);

    if (reading != lastReading) {
      lastReading = reading;
      lastChange = millis();
    }

    if (reading != stableState && millis() - lastChange >= DEBOUNCE_MS) {
      stableState = reading;
      if (stableState == LOW) {
        pressed = true;
      }
    }
  }
};

Button nextButton = { BUTTON_NEXT, HIGH, HIGH, 0, false };
Button prevButton = { BUTTON_PREV, HIGH, HIGH, 0, false };

// Call this often
void pollButtons() {
  nextButton.update();
  prevButton.update();
}

// ======================================================================
//  TFT: JPEG ANIMATION
// ======================================================================

// JPEGDEC calls this for every decoded block of pixels
int drawJPEG(JPEGDRAW *pDraw) {
  tft.drawRGBBitmap(pDraw->x, pDraw->y, pDraw->pPixels, pDraw->iWidth, pDraw->iHeight);

  // Catches short presses while a frame is being decoded
  pollButtons();

  return 1;
}

bool playJPEGFrame(int frameIndex) {
  if (frameIndex < 0 || frameIndex >= FRAME_COUNT) {
    return false;
  }

  uint32_t offset = pgm_read_dword(&frameOffsets[frameIndex]);
  uint32_t size   = pgm_read_dword(&frameSizes[frameIndex]);

  const uint8_t *frameData = &animationData[offset];

  if (!jpeg.openFLASH(frameData, (int)size, drawJPEG)) {
    return false;
  }

  jpeg.setPixelType(RGB565_LITTLE_ENDIAN);
  bool success = jpeg.decode(0, 0, 0);
  jpeg.close();

  return success;
}

// ======================================================================
//  OLED
// ======================================================================

void setupOLED() {
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!oled.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    Serial.println("OLED not found! Check wiring and the I2C address.");
    while (true) {
      delay(100);
    }
  }

  oled.setTextWrap(false);
  oled.clearDisplay();
  oled.display();

  Serial.println("OLED initialized");
}

void updateOLED() {
  oled.clearDisplay();
  oled.setTextColor(SSD1306_WHITE);

  // Scrolling line
  oled.setTextSize(1);
  oled.setCursor(textX, 6);
  oled.print(scrollingTexts[oledScreen]);

  // Centered caption + star (text size 2 = 12 px per character)
  const char *mainText = mainTexts[oledScreen];
  const int nameWidth  = strlen(mainText) * 12;
  const int gap        = 6;
  const int groupWidth = nameWidth + gap + STAR_W;
  const int nameX      = (OLED_WIDTH - groupWidth) / 2;

  oled.setTextSize(2);
  oled.setCursor(nameX, 34);
  oled.print(mainText);

  oled.drawBitmap(
    nameX + nameWidth + gap,
    34 + (16 - STAR_H) / 2,
    starBitmap,
    STAR_W,
    STAR_H,
    SSD1306_WHITE
  );

  oled.display();
}

// Runs independently of the TFT loop. Only this task touches the OLED.
void oledTask(void *param) {
  TickType_t lastWake = xTaskGetTickCount();

  while (true) {
    // New screen: restart its text from the right edge
    if (oledScreen != currentScreen) {
      oledScreen = currentScreen;
      textX = OLED_WIDTH;
    }

    const int textWidth = strlen(scrollingTexts[oledScreen]) * 6;

    textX--;
    if (textX < -textWidth) {
      textX = OLED_WIDTH;
    }

    updateOLED();

    // Fixed scroll rate: 1 px per SCROLL_INTERVAL ms
    vTaskDelayUntil(&lastWake, pdMS_TO_TICKS(SCROLL_INTERVAL));
  }
}

// ======================================================================
//  SETUP
// ======================================================================

void setup() {
  Serial.begin(115200);

  pinMode(BUTTON_NEXT, INPUT_PULLUP);
  pinMode(BUTTON_PREV, INPUT_PULLUP);

  SPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);

  tft.init(240, 280);
  tft.setRotation(0);
  tft.setSPISpeed(20000000);
  tft.fillScreen(ST77XX_BLACK);

  setupOLED();
  updateOLED();

  // The OLED scroller runs as its own task
  xTaskCreate(oledTask, "oled", 4096, NULL, 1, NULL);

  Serial.println("Digital ID Card ready");
  Serial.printf("Animation frames: %d\n", FRAME_COUNT);
  Serial.printf("Resolution: %d x %d\n", FRAME_WIDTH, FRAME_HEIGHT);
}

// ======================================================================
//  MAIN LOOP
//  Draws the current screen and handles the buttons.
// ======================================================================

void loop() {
  static int screen = 0;  // 0 = animation, 1.. = images[screen - 1]
  static int frameIndex = 0;
  static bool imageDrawn = false;

  if (screen == 0) {
    unsigned long startTime = millis();
    uint16_t frameDelay = pgm_read_word(&frameDelays[frameIndex]);

    playJPEGFrame(frameIndex);

    frameIndex++;
    if (frameIndex >= FRAME_COUNT) {
      frameIndex = 0;
    }

    // delay() yields so the OLED task keeps running.
    // A button press ends the wait early.
    do {
      pollButtons();
      delay(5);
    } while (!nextButton.pressed && !prevButton.pressed &&
             millis() - startTime < frameDelay);

  } else {
    // A still image only needs drawing once
    if (!imageDrawn) {
      tft.drawRGBBitmap(
        0,
        0,
        const_cast<uint16_t *>(images[screen - 1]),
        FRAME_WIDTH,
        FRAME_HEIGHT
      );
      imageDrawn = true;
    }

    pollButtons();
    delay(5);
  }

  if (nextButton.pressed || prevButton.pressed) {
    if (nextButton.pressed) {
      screen = (screen + 1) % SCREEN_COUNT;
    }
    if (prevButton.pressed) {
      screen = (screen - 1 + SCREEN_COUNT) % SCREEN_COUNT;
    }

    nextButton.pressed = false;
    prevButton.pressed = false;

    currentScreen = screen;
    frameIndex = 0;
    imageDrawn = false;
  }
}
